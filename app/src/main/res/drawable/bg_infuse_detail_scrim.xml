<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Scrim horizontal gauche -> droite laissant la moitié droite de l'image totalement nette comme sur Mad Men -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#A6111318"
                android:endColor="#00111318"
                android:startColor="#E6111318"
                android:type="linear" />
        </shape>
    </item>
    <!-- Scrim vertical bas -> haut sous Season 1 et Cast and Crew -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#59111318"
                android:endColor="#00111318"
                android:startColor="#FF0E1014"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
