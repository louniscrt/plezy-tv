<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile Verre Fumé Sombre Style Infuse 8 / Apple TV (remplace les gros blocs fluo) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#1AFFFFFF"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#221C2230"
                android:endColor="#14111620"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#24334460" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
