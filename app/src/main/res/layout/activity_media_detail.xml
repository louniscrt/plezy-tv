<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090F">

    <!-- Artwork 16:9 plein écran lumineux à droite (Style Netflix / Apple TV) -->
    <ImageView
        android:id="@+id/ivDetailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.88"
        android:scaleType="centerCrop" />

    <!-- Dégradé cinématique Netflix / Infuse -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="48dp"
        android:paddingTop="36dp"
        android:paddingRight="48dp"
        android:paddingBottom="32dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Badge [P] S E E R R / F I L M -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="20dp"
                    android:background="#E50914"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailGenres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.14"
                    android:text="FILM  ·  ACTION"
                    android:textAllCaps="true"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ClearLogo officiel transparent Jellyfin -->
            <ImageView
                android:id="@+id/ivDetailLogo"
                android:layout_width="280dp"
                android:layout_height="64dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <!-- Grand Titre Cinématique Netflix -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="580dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:text="TITRE"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Sous-titre de l'épisode ("S1 • E2 - Titre") -->
            <TextView
                android:id="@+id/tvDetailEpisodeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Ligne technique épurée : Note + Année + Durée + Classification + Qualité -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTmdbRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="★ 8.2"
                    android:textColor="#4ADE80"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="2024   1h 58m"
                    android:textColor="#D6D9E0"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvTechRatingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_rating_outline"
                    android:fontFamily="sans-serif-medium"
                    android:text="16+"
                    android:textColor="#E2E5EC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailMetaRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="1080p"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMetacriticScore"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTraktScore"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ==================================================================== -->
            <!-- UNE SEULE RANGÉE DE BOUTONS ÉPURÉE (Netflix + Apple TV Liquid Glass) -->
            <!-- [ ▶ Lecture / ＋ Demander ]   [ Bande-annonce ]   [ ＋ ]   [ ••• ]   -->
            <!-- ==================================================================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Bouton Primaire Blanc Netflix -->
                <Button
                    android:id="@+id/btnPlayEpisode"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_netflix_play_btn"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="156dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="▶  Lecture"
                    android:textAllCaps="false"
                    android:textColor="@color/netflix_play_text_color"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- Bouton Secondaire Liquid Glass -->
                <Button
                    android:id="@+id/btnOverseerrRequest"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_netflix_glass_btn"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="136dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="Bande-annonce"
                    android:textAllCaps="false"
                    android:textColor="@color/pill_text_color"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- Bouton Ma Liste (Bookmark discret Liquid Glass) -->
                <FrameLayout
                    android:id="@+id/btnShuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_netflix_glass_btn"
                    android:clickable="true"
                    android:contentDescription="Ajouter à Ma liste"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_infuse_bookmark"
                        app:tint="@color/pill_text_color" />
                </FrameLayout>

                <!-- Bouton Plus d'options (••• discret Liquid Glass) -->
                <FrameLayout
                    android:id="@+id/btnMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_netflix_glass_btn"
                    android:clickable="true"
                    android:contentDescription="Plus d’options"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_infuse_more_dots"
                        app:tint="@color/pill_text_color" />
                </FrameLayout>

                <!-- Vues masquées conservées pour compatibilité sans surcharger l'interface -->
                <FrameLayout android:id="@+id/btnMarkWatched" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <FrameLayout android:id="@+id/btnRateStar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <FrameLayout android:id="@+id/btnDownload" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <!-- Synopsis 3 lignes max sous les boutons (comme Netflix) -->
            <TextView
                android:id="@+id/tvDetailOverview"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text=""
                android:textColor="#E2E8F0"
                android:textSize="12.5sp" />

            <!-- ==================================================================== -->
            <!-- RAIL DES ÉPISODES / RECOMMANDATIONS                                  -->
            <!-- ==================================================================== -->
            <TextView
                android:id="@+id/tvSeason1Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Saison 1"
                android:textColor="#F3F4F6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeason1"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:clipToPadding="false" />

            <!-- ==================================================================== -->
            <!-- RAIL DISTRIBUTION (CAST)                                             -->
            <!-- ==================================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Distribution"
                android:textColor="#F3F4F6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCastCrew"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvCastList"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSeason2Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeason2"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
