<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Surface vidéo ExoPlayer -->
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <ProgressBar
        android:id="@+id/playerBuffering"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

    <!-- OVERLAY LECTEUR COMPACT & DISCRET (NETFLIX / APPLE TV LIQUID GLASS) -->
    <FrameLayout
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ============================================================ -->
        <!-- BANDEAU SUPÉRIEUR FIN & DISCRET (52dp)                       -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_player_top_scrim"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="6dp"
            android:paddingRight="24dp">

            <ImageView
                android:id="@+id/btnPlayerBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_player_control_button"
                android:clickable="true"
                android:contentDescription="Quitter le lecteur"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_player_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="Titre"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text=""
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStreamModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_badge_request"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="Direct Play · 1080p"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- DOCK INFÉRIEUR COMPACT LIQUID GLASS (Discret, 68dp de haut)  -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="700dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_infuse_player_glass"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp">

            <!-- LIGNE 1 : Scrubber fin & Horaires -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvElapsedTime"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <com.plezy.jellyfin.ui.player.SegmentedChapterBar
                    android:id="@+id/chapterProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:contentDescription="Position de lecture"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:text="-00:00"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEndsAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_player_pill_action"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="Fin à --:--"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- LIGNE 2 UNIFIÉE : Contrôles de lecture à gauche + Options à droite (Ultra-compact) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Chapitre Précédent -->
                <ImageView
                    android:id="@+id/btnPrev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_player_control_button"
                    android:clickable="true"
                    android:contentDescription="Chapitre précédent"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_prev" />

                <View
                    android:id="@+id/btnRewindFast"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Recul 10s -->
                <ImageView
                    android:id="@+id/btnReplay10"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_player_control_button"
                    android:clickable="true"
                    android:contentDescription="Reculer de 10 secondes"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_replay10" />

                <!-- Bouton Play/Pause compact (38dp au lieu de 64dp) -->
                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_player_play_button"
                    android:clickable="true"
                    android:contentDescription="Lecture ou pause"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_player_pause" />

                <!-- Avance 10s -->
                <ImageView
                    android:id="@+id/btnForward10"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_player_control_button"
                    android:clickable="true"
                    android:contentDescription="Avancer de 10 secondes"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_forward10" />

                <View
                    android:id="@+id/btnFastForward"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Chapitre Suivant -->
                <ImageView
                    android:id="@+id/btnNext"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_player_control_button"
                    android:clickable="true"
                    android:contentDescription="Chapitre ou épisode suivant"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Pilules d'options compactes (28dp de haut) -->
                <TextView
                    android:id="@+id/btnSubtitles"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_player_pill_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:text="Audio / ST"
                    android:textColor="@color/pill_text_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_player_pill_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:text="Qualité"
                    android:textColor="@color/pill_text_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAspect"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_player_pill_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:text="Format"
                    android:textColor="@color/pill_text_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnChapters"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_player_pill_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:text="Chapitres"
                    android:textColor="@color/pill_text_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnAirPlay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_player_control_button"
                    android:clickable="true"
                    android:contentDescription="Informations de lecture"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_player_airplay" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
