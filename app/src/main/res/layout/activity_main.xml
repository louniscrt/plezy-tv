<?xml version="1.0" encoding="utf-8"?>
<!--
    Reproduction 1:1 de l'interface Netflix TV 2026 (Photos & Vidéos utilisateur) :
    - Barre de navigation supérieure : Profil, Recherche, Accueil, Séries, Films, Nouveautés Seerr, Mon Netflix, Logo Plezy
    - Grand Billboard cinématique : [P] FILM / S É R I E -> Titre géant -> Métadonnées + Badges -> Synopsis -> 2 Boutons -> Capsules Catégories (TF1+, Nouveautés...)
    - Rangées de vignettes 16:9, In-Row Expansion et rangée Top 10 à grands chiffres détourés
    - Dégradés cinématographiques sans débordement
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <!-- Fond visuel plein écran (Backdrop) -->
    <ImageView
        android:id="@+id/ivHeroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Dégradé latéral gauche Netflix : noir sur la gauche pour lisibilité du texte -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nfx_scrim_left" />

    <!-- Dégradé vertical haut Netflix : lisibilité de la barre supérieure -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_nfx_scrim_top" />

    <!-- Dégradé vertical bas Netflix : obscurcit le tiers inférieur sous les rangées -->
    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nfx_scrim_bottom" />

    <!-- ==================================================================== -->
    <!-- 1. BARRE DE NAVIGATION SUPÉRIEURE (Frame 73 / 76 / 81 vidéo 8)       -->
    <!-- ==================================================================== -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="18dp"
        android:paddingEnd="40dp"
        android:paddingBottom="10dp">

        <!-- Avatar Profil ("L") -->
        <TextView
            android:id="@+id/navProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_nfx_avatar"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="L"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 1. Recherche (🔍) -->
        <FrameLayout
            android:id="@+id/navSearch"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_infuse_search"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 2. Accueil (Pilule active par défaut) -->
        <TextView
            android:id="@+id/navHome"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Accueil"
            android:textColor="@color/nfx_nav_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 3. Séries -->
        <TextView
            android:id="@+id/navSeries"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Séries"
            android:textColor="@color/nfx_nav_text"
            android:textSize="12sp" />

        <!-- 4. Films -->
        <TextView
            android:id="@+id/navMovies"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Films"
            android:textColor="@color/nfx_nav_text"
            android:textSize="12sp" />

        <!-- 5. Nouveautés Seerr -->
        <TextView
            android:id="@+id/navOverseerr"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Nouveautés Seerr"
            android:textColor="@color/nfx_nav_text"
            android:textSize="12sp" />

        <!-- 6. Mon Netflix -->
        <TextView
            android:id="@+id/navDownloads"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_nfx_nav_tab"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Mon Netflix"
            android:textColor="@color/nfx_nav_text"
            android:textSize="12sp" />

        <!-- Espaceur flexible -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Logo PLEZY / N rouge en haut à droite -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="N"
                android:textColor="#E50914"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBrandWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="PLEZY"
                android:textColor="#E50914"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================================================================== -->
    <!-- CONTENEUR PRINCIPAL DE NAVIGATION (BILLBOARD + RANGÉES)              -->
    <!-- ==================================================================== -->
    <FrameLayout
        android:id="@+id/browseContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- BILLBOARD NETFLIX : Titre, Métadonnées, Badges, 2 boutons, Synopsis -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="64dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Ligne 1 : Logo "P" rouge + Tag "F I L M" / "S É R I E" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrandLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="P"
                    android:textColor="#E50914"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroCategoryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.32"
                    android:text="F I L M"
                    android:textColor="#D1D5DB"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ligne 2 : ClearLogo officiel ou Titre Grand Format -->
            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="340dp"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="COLISIÓN"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Ligne 3 : Métadonnées + Badges rouges (Ajout récent / N° 1) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHeroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Film • Thriller • 2026 • 1 h 46 min • 16+"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHeroBadgeRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_nfx_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Ajout récent"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroBadgeRank"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_nfx_badge_red"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="N° 1 des films"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ligne 4 : Synopsis placé DIRECTEMENT sous les métadonnées -->
            <TextView
                android:id="@+id/tvHeroOverview"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Un casse parfaitement orchestré dissimule les véritables intentions d'une bande de malfrats dans ce thriller haletant."
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <!-- Ligne 5 : Les 2 boutons Netflix [ ▶ Lecture ] [ Plus d'infos ] -->
            <LinearLayout
                android:id="@+id/heroButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_netflix_play_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp"
                    android:text="▶  Lecture"
                    android:textColor="@color/netflix_play_text_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHeroMoreInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_netflix_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp"
                    android:text="Plus d'infos"
                    android:textColor="@color/netflix_more_info_text_color"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ligne 6 : Capsules de catégories horizontales (TF1+, Nouveautés, etc.) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="TF1+"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Nouveautés et incontournables"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="THRILLERS"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="DRAMES"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="POLICIERS"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_nfx_category_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="HUMOUR"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout android:id="@+id/rowCallout" android:orientation="vertical" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvHeroCallout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvTop10Badge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMetaYear" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMetaRating" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- RANGÉES DÉROULANTES NETFLIX -->
        <com.plezy.jellyfin.ui.common.RowsScrollView
            android:id="@+id/rowsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="318dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="280dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </com.plezy.jellyfin.ui.common.RowsScrollView>

        <TextView
            android:id="@+id/tvHomeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="320dp"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ==================================================================== -->
    <!-- RECHERCHE NETFLIX                                                    -->
    <!-- ==================================================================== -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="58dp"
        android:background="#05070B"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingTop="24dp"
        android:paddingRight="40dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="480dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nfx_search_field"
            android:drawableStart="@drawable/ic_infuse_search"
            android:drawablePadding="12dp"
            android:hint="Rechercher des films, séries, acteurs…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8C8C8C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Recherches populaires"
            android:textColor="#E5E5E5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConnectSeerr"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nfx_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Connecter Seerr pour rechercher et demander les titres absents"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />
    </LinearLayout>

</FrameLayout>
