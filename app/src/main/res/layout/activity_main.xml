</LinearLayout>
<TextView android:id="@+id/tvHomeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chargement de votre bibliothèque…" android:textColor="#BBC8D8" android:textSize="13sp"/>
