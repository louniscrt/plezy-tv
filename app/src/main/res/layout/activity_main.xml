<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Films récemment ajoutés" android:textSize="21sp" android:textColor="#F5F6FA" android:fontFamily="sans-serif-medium"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHomeMovies" android:layout_width="match_parent" android:layout_height="302dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:clipChildren="false" android:clipToPadding="false"/>
