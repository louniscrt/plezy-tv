<TextView android:id="@+id/navOverseerr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/><TextView android:id="@+id/tvUserAvatar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
