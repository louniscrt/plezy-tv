<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Explorer" android:textSize="21sp" android:textColor="#F5F6FA" android:fontFamily="sans-serif-medium"/><LinearLayout android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal" android:clipChildren="false"><LinearLayout android:id="@+id/tileFavOverseerr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="96dp" android:layout_margin="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile_orange" android:focusable="true" android:clickable="true"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_infuse_star_tile"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Découvrir" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium"/></LinearLayout>
