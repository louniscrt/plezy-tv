<?xml version="1.0" encoding="utf-8"?>
<!--
    Reproduction 1:1 de l'interface Netflix TV (media_1793484172329_ae29df35.png) :
    - Barre latérale gauche 54dp avec filet rouge d'activation vertical de 3.5dp
    - Grand Billboard cinématique : [P] FILM / S É R I E -> Titre géant -> [ ▶ Lecture ] [ Plus d'infos ] -> Synopsis
    - Tag de classification flottant à droite (| 16+)
    - Logo PLEZY rouge en bas à droite au-dessus des rangées
    - Rangées de vignettes 16:9 et rangée Top 10 à grands chiffres
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <!-- Fond visuel plein écran (Backdrop) -->
    <ImageView
        android:id="@+id/ivHeroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Dégradé latéral gauche Netflix : noir sur la gauche pour lisibilité du texte -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nfx_scrim_left" />

    <!-- Dégradé vertical bas Netflix : obscurcit le tiers inférieur sous les rangées -->
    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nfx_scrim_bottom" />

    <!-- Badge classification à droite de l'écran (style "| 16+" exact de Netflix) -->
    <LinearLayout
        android:id="@+id/layoutHeroMeta"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="232dp"
        android:background="#73000000"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#E5FFFFFF" />

        <TextView
            android:id="@+id/tvHeroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:text="16+"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Logo PLEZY rouge vif en bas à droite (exactement comme le logo NETFLIX dans le screenshot) -->
    <TextView
        android:id="@+id/tvBrandWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="348dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:text="PLEZY"
        android:textColor="#E50914"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- ==================================================================== -->
    <!-- CONTENEUR PRINCIPAL DE NAVIGATION (BILLBOARD + RANGÉES)              -->
    <!-- ==================================================================== -->
    <FrameLayout
        android:id="@+id/browseContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="54dp"
        android:clipChildren="false">

        <!-- BILLBOARD NETFLIX : Titre, 2 boutons, synopsis dessous -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginTop="72dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Ligne 1 : Logo "P" rouge + Tag "F I L M" / "S É R I E" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrandLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="P"
                    android:textColor="#E50914"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroCategoryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.32"
                    android:text="F I L M"
                    android:textColor="#D1D5DB"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ligne 2 : ClearLogo officiel ou Titre Grand Format -->
            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="340dp"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="THE OLD GUARD"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- Ligne 3 : LES 2 BOUTONS NETFLIX [ ▶ Lecture ] [ Plus d'infos ] -->
            <LinearLayout
                android:id="@+id/heroButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_netflix_play_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="126dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="22dp"
                    android:text="▶  Lecture"
                    android:textColor="@color/netflix_play_text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHeroMoreInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_netflix_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="126dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="22dp"
                    android:text="Plus d'infos"
                    android:textColor="@color/netflix_more_info_text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ligne 4 : Synopsis placé DIRECTEMENT sous les boutons (exactement comme Netflix) -->
            <TextView
                android:id="@+id/tvHeroOverview"
                android:layout_width="460dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="Pendant des siècles, ces quatre guerriers protégeaient secrètement l'humanité. Maintenant, leurs dons en font des cibles."
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <LinearLayout android:id="@+id/rowCallout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvHeroCallout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvTop10Badge" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMetaYear" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMetaRating" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- RANGÉES DÉROULANTES NETFLIX -->
        <com.plezy.jellyfin.ui.common.RowsScrollView
            android:id="@+id/rowsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="376dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="360dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </com.plezy.jellyfin.ui.common.RowsScrollView>

        <TextView
            android:id="@+id/tvHomeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginTop="380dp"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ==================================================================== -->
    <!-- RECHERCHE NETFLIX                                                    -->
    <!-- ==================================================================== -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="54dp"
        android:background="#05070B"
        android:orientation="vertical"
        android:paddingLeft="34dp"
        android:paddingTop="36dp"
        android:paddingRight="36dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="480dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nfx_search_field"
            android:drawableStart="@drawable/ic_infuse_search"
            android:drawablePadding="12dp"
            android:hint="Rechercher des films, séries, acteurs…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8C8C8C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Recherches populaires"
            android:textColor="#E5E5E5"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- ==================================================================== -->
    <!-- BARRE LATÉRALE GAUCHE NETFLIX TV (Exactement comme le screenshot)    -->
    <!-- ==================================================================== -->
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="54dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_netflix_sidebar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="120dp"
        android:paddingBottom="20dp">

        <!-- 1. Recherche (🔍) -->
        <FrameLayout
            android:id="@+id/navSearch"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Rechercher"
            android:focusable="true">

            <View
                android:id="@+id/barNavSearch"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_infuse_search"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 2. Accueil (🏠) avec filet rouge vertical -->
        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Accueil"
            android:focusable="true">

            <View
                android:id="@+id/barNavHome"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="visible" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 3. Séries (📺) -->
        <FrameLayout
            android:id="@+id/navSeries"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Séries"
            android:focusable="true">

            <View
                android:id="@+id/barNavSeries"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_infuse_tv"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 4. Films (🎬 Clapperboard) -->
        <FrameLayout
            android:id="@+id/navMovies"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Films"
            android:focusable="true">

            <View
                android:id="@+id/barNavMovies"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_movies"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 5. Ma liste (➕) -->
        <FrameLayout
            android:id="@+id/navDownloads"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Ma liste"
            android:focusable="true">

            <View
                android:id="@+id/barNavDownloads"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_plus"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <!-- 6. Nouveautés / Découverte Seerr (🗂️) -->
        <FrameLayout
            android:id="@+id/navOverseerr"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Nouveautés"
            android:focusable="true">

            <View
                android:id="@+id/barNavOverseerr"
                android:layout_width="3.5dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:background="#E50914"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_categories"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Profil Avatar (carré bleu "L") -->
        <TextView
            android:id="@+id/navProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_nfx_avatar"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="L"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Réglages (⚙️) -->
        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_sidebar_btn"
            android:clickable="true"
            android:contentDescription="Réglages"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:src="@drawable/ic_infuse_settings"
                app:tint="@color/nfx_sidebar_icon_tint" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
