                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:text="Bibliothèque"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabRecommended"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:text="Top Notés"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabCollections"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:text="Collections"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:text="✨ Seerr / TMDB"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnFilterType"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:text="Tous les types"
                android:textColor="@color/pill_text_color"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFilterUnplayed"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:text="Tous"
                android:textColor="@color/pill_text_color"
                android:textSize="12sp" />

            <TextView
