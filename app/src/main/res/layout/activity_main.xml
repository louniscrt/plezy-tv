    <!-- ==================================================================== -->
    <!-- VUE 3 : RECHERCHE INFUSE + OVERSEERR                                 -->
    <!-- ==================================================================== -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="84dp"
        android:orientation="vertical"
        android:paddingLeft="42dp" android:paddingRight="42dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="580dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_liquid_glass_panel"
            android:hint="Search Movies, TV Shows &amp; Overseerr..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="18dp" android:paddingRight="18dp"
