<?xml version="1.0" encoding="utf-8"?>
<!-- Carte "Top 10" Netflix : grand chiffre détouré + affiche verticale -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="190dp"
    android:layout_height="131dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true">

    <com.plezy.jellyfin.ui.common.OutlinedNumberView
        android:id="@+id/tvRank"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <FrameLayout
        android:id="@+id/tileFrame"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_nfx_tile"
        android:duplicateParentState="true"
        android:foreground="@drawable/bg_nfx_tile_focus">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nfx_tile"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_nfx_badge_red"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:textColor="#FFFFFF"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
