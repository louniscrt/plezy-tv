<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:padding="28dp">

        <!-- ========================================================== -->
        <!-- COLONNE GAUCHE : QUICK CONNECT (RECOMMANDÉ SUR FIRE TV)    -->
        <!-- ========================================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Connect"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Ouvrez l'interface Web Jellyfin (Quick Connect)\net entrez ce code à 6 chiffres :"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Grand Code à 6 chiffres Quick Connect -->
            <TextView
                android:id="@+id/tvQuickConnectCode"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="16dp"
                android:background="@color/bg_pill"
                android:gravity="center"
                android:letterSpacing="0.25"
                android:text="------"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuickConnectStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Génération du code Quick Connect..."
                android:textColor="#5CE1E6"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQuickConnect"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:text="↻  Nouveau code Quick Connect"
                android:textAllCaps="false"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDemoMode"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:text="@string/demo_mode_button"
                android:textAllCaps="false"
                android:textColor="@color/pill_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Séparateur vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2E2E36" />

        <!-- ========================================================== -->
        <!-- COLONNE DROITE : SERVEUR & IDENTIFIANTS MANUELS            -->
        <!-- ========================================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connexion Manuelle"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Serveur Jellyfin (Umbrel détecté)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/bg_pill"
                android:hint="@string/server_url_hint"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:paddingLeft="12dp" android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@color/bg_pill"
                android:hint="@string/username_hint"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:paddingLeft="12dp" android:paddingRight="12dp"
                android:singleLine="true"
                android:text="lounis"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@color/bg_pill"
                android:hint="@string/password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingLeft="12dp" android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:text="@string/connect_button"
                android:textAllCaps="false"
                android:textColor="@color/pill_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
