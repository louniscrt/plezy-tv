<?xml version="1.0" encoding="utf-8"?>
<!-- Carte Acteur Cast and Crew identique au bas de l'écran Infuse (Mad Men image 1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="3dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="122dp"
        android:background="@drawable/bg_card_focus"
        android:padding="2dp">

        <ImageView
            android:id="@+id/ivCastPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rounded_image_14"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCastName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Jon Hamm"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvCastRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Don Draper"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

</LinearLayout>
