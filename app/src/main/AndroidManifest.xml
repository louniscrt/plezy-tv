<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Déclaration Fire TV / Android TV (Leanback sans écran tactile requis) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- ExoPlayer DownloadService is not declared or used; downloads are foreground HTTP operations without notifications. -->
    <application
        android:name=".PlezyApp"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_banner"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlezyTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="28">

        <!-- Écran de connexion au serveur Jellyfin / Démarrage -->
        <activity
            android:name=".ui.login.ServerSetupActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran principal (Accueil + Bibliothèque type Plezy) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Écran Détails Média / Saisons & Épisodes (tv-md) -->
        <activity
            android:name=".ui.detail.MediaDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Lecteur Vidéo ExoPlayer avec chapitres & transcodage auto (tv-player) -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

    </application>

</manifest>
